#!/usr/bin/env bash
set -Eeuo pipefail
root_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
meson="$root_dir/build/qemu/pyvenv/bin/meson"
if [[ ! -x "$meson" ]]; then
    printf '%s\n' 'blocked: QEMU Meson environment is missing; run tools/build-qemu.sh first' >&2
    exit 1
fi
exec "$meson" "$@"
