<?xml version="1.0"?>
<!-- Test-only primitive scene. Native Physics / Sensors own all simulation.
     Sensor configuration follows gz-sim 8.15.0 camera_sensor.sdf and
     gpu_lidar_sensor.sdf; no GUI, downloaded assets or custom plugins. -->
<sdf version="1.10">
  <world name="rendering_gate">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0 0 0 1</background>
    </scene>
    <model name="target">
      <static>true</static>
      <pose>3 0 0 0 0 0</pose>
      <link name="body">
        <collision name="box">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        <visual name="red_box">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="sensors">
      <static>true</static>
      <link name="body">
        <sensor name="camera" type="camera">
          <topic>/dm_render/image</topic>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>64</width><height>48</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10</far></clip>
          </camera>
        </sensor>
        <sensor name="lidar" type="gpu_lidar">
          <topic>/dm_render/scan</topic>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>65</samples><resolution>1</resolution>
                <min_angle>-0.3</min_angle><max_angle>0.3</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples><resolution>1</resolution>
                <min_angle>0</min_angle><max_angle>0</max_angle>
              </vertical>
            </scan>
            <range><min>0.1</min><max>10</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
