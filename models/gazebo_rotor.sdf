<?xml version="1.0"?>
<!-- Uncalibrated world-anchored rotor fixture: Izz=.02 kg m², zero gravity.
     Gazebo/DART owns integration. No motor, gearbox or transport model. -->
<sdf version="1.10">
  <world name="rotor_world">
    <gravity>0 0 0</gravity>
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <model name="rotor">
      <link name="body">
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.015</ixx><iyy>0.015</iyy><izz>0.02</izz></inertia>
        </inertial>
      </link>
      <joint name="shaft" type="revolute">
        <parent>world</parent><child>body</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper><effort>10</effort></limit>
          <dynamics><damping>0</damping></dynamics>
        </axis>
      </joint>
    </model>
  </world>
</sdf>
